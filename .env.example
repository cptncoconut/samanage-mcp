# Optional file for local dev. In production, prefer passing these via your
# MCP client's server config `env` block (no disk exposure). This file is only
# consulted for variables that are NOT already set in the process environment.
# Protect with: chmod 600 .env
SAMANAGE_API_TOKEN=
# Or load the token from a file (takes precedence over .env's SAMANAGE_API_TOKEN
# when SAMANAGE_API_TOKEN is empty):
# SAMANAGE_API_TOKEN_FILE=/run/secrets/samanage_api_token
SAMANAGE_BASE_URL=https://api.samanage.com
SAMANAGE_DRY_RUN=false
SAMANAGE_DEFAULT_REQUESTER=
LOG_LEVEL=INFO
# --- Attachment safety ---
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_URL_ALLOWED_HOSTS=
ATTACHMENT_ALLOW_PRIVATE_IPS=false
ATTACHMENT_MAX_REDIRECTS=3
ATTACHMENT_ALLOW_LOCAL_PATHS=false
ATTACHMENT_ROOT=
